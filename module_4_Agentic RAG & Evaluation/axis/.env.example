# Axis configuration — copy to .env and fill in.
#
# Every variable is prefixed AXIS_. Nested settings use a double underscore,
# so AXIS_LLM__PROVIDER maps to settings.llm.provider.
#
# Secrets are read ONLY by the AI Backend (ai_backend/config/settings.py) and
# are typed as SecretStr, so they render as ********** in any log line, repr,
# or traceback. They are never handed to the Frontend and are scrubbed from
# every AgentStep before it is persisted.

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# openai | anthropic | ollama | fake
AXIS_LLM__PROVIDER=openai
AXIS_LLM__MODEL=gpt-4o-mini
AXIS_LLM__API_KEY=sk-replace-me
# AXIS_LLM__BASE_URL=            # override for a proxy or self-hosted gateway

# ---------------------------------------------------------------------------
# Embedding provider
# ---------------------------------------------------------------------------
# openai | ollama | fake  — note: Anthropic publishes no embeddings API, so
# selecting it here fails fast at startup with an explanatory error.
AXIS_EMBEDDING__PROVIDER=openai
AXIS_EMBEDDING__MODEL=text-embedding-3-small
AXIS_EMBEDDING__API_KEY=sk-replace-me
# AXIS_EMBEDDING__BASE_URL=

# ---------------------------------------------------------------------------
# Running with no API keys at all
# ---------------------------------------------------------------------------
# Ollama is the zero-key path — useful for a laptop demo with no budget, or a
# classroom where provider keys have not been issued yet:
#
#   AXIS_LLM__PROVIDER=ollama
#   AXIS_LLM__MODEL=llama3.1
#   AXIS_LLM__BASE_URL=http://127.0.0.1:11434
#   AXIS_EMBEDDING__PROVIDER=ollama
#   AXIS_EMBEDDING__MODEL=nomic-embed-text
#
# Startup validation only demands keys for the providers actually selected, so
# an Ollama-only configuration boots with none.

# ---------------------------------------------------------------------------
# Web search (the agent's only route to the network)
# ---------------------------------------------------------------------------
# Setting this makes the route *available* and puts a "Web search" toggle in the
# sidebar. It does not turn it on: the toggle starts off, and only the agentic
# strategy can use it — and only when a document search has already come up empty.
#
#   none     the default. No toggle, and the model is never offered the web tool.
#   fake     offline, deterministic. What the test suite uses; fine for a rehearsal.
#   cached   recorded real results, for a repeatable class demo. Record them yourself:
#            hand-written snippets would make the demo a lie.
#   serpapi  live, and paid per call. Needs AXIS_SEARCH__API_KEY.
#
# Snippet-only in every case: Axis shows a result's URL and never fetches it.
# AXIS_SEARCH__PROVIDER=none
# AXIS_SEARCH__API_KEY=

# ---------------------------------------------------------------------------
# The semantic cache
# ---------------------------------------------------------------------------
# **On by default**, unlike the web route and the demo corpus below — and the
# asymmetry is the point rather than an oversight. Those two are off because
# using them *spends*: a paid third-party call, four paid embedding round trips.
# A cache hit only ever avoids spending, so the reasoning that gates them does
# not apply, and a cache an instructor has to switch on is a cache the class
# never sees.
#
# The sidebar toggle exists for the opposite case: charging full price for a
# question already asked, so what the cache was saving can be demonstrated
# rather than asserted.
#
# Cosine, compared against the closest stored question. Stricter than the
# reference implementation's equivalent (0.90), because the failure directions
# are not symmetric: a miss costs one query, and a hit on a question that merely
# looked similar answers something the student did not ask, with citations.
# AXIS_CACHE__ENABLED=true
# AXIS_CACHE__MIN_SIMILARITY=0.92
# AXIS_CACHE__MAX_ENTRIES=64
#
# Offline note worth knowing before a class: against the fake embedding provider
# the cache hits on repeats and rewordings but *not* on a true paraphrase — a
# hashed bag of words cannot tell that "how soon must it be paid" means "when is
# payment due". Semantic caching is the selling point and it needs real
# embeddings. See ai_backend/agents/cache.py for the measured figures.

# ---------------------------------------------------------------------------
# The orchestration stages
# ---------------------------------------------------------------------------
# The query rewriter, which resolves a follow-up before anything is searched
# for. Turning it off and re-asking a follow-up is the fastest way to show what
# it was doing — the step is still traced, reporting that no LLM call was made.
# AXIS_AGENT__REWRITE_ENABLED=true

# ---------------------------------------------------------------------------
# Per-session caps — the single most important control for a workshop.
# Checked BEFORE any provider call, never after.
# ---------------------------------------------------------------------------
AXIS_CAPS__MAX_COST_USD_PER_SESSION=2.00
AXIS_CAPS__MAX_REQUESTS_PER_SESSION=50
# At least 4: rewrite, route, decompose, synthesize. Axis refuses to start below
# that rather than running an agentic query that cannot complete.
AXIS_CAPS__MAX_LLM_CALLS_PER_QUERY=20
AXIS_CAPS__MAX_AGENT_ITERATIONS=5
AXIS_CAPS__MAX_TOOL_CALLS_PER_QUERY=8

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
AXIS_UPLOAD__MAX_FILES_PER_SESSION=5
AXIS_UPLOAD__MAX_BYTES_PER_FILE=26214400
# Guards against zip bombs: PPTX and XLSX are zip containers.
AXIS_UPLOAD__MAX_UNCOMPRESSED_BYTES=262144000

# ---------------------------------------------------------------------------
# Demo corpus
# ---------------------------------------------------------------------------
# The one-click "Load the demo set" button, and with it the labelled example
# questions in the ask bar and every run on the *Why agentic* page.
#
# The corpus is the five ACME Aerospace program documents in `data/` at the repo
# root — see `data/README.md`. Copied from `reference/module_3_Enterprise RAG/data/`,
# the material this cohort was already taught on; that folder is never read at
# runtime. They interlock on purpose, which is what makes the multi-hop
# demonstration possible at all.
#
# Off by default because loading it indexes four documents through the configured
# embedding provider — free on `fake`, four paid round trips per click on a real
# one, from a button in the sidebar, in a room of twenty. Turn it on for a class
# that needs the corpus the predicted outcomes were measured against.
#
# The example questions follow this flag, and then wait for the documents: a
# prediction is a claim about a specific corpus, so offering one beside somebody
# else's PDFs would have Axis confidently predicting an outcome nothing measured.
AXIS_DEMO__DOCUMENTS_ENABLED=false

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
AXIS_SERVER__HOST=127.0.0.1
AXIS_SERVER__PORT=8000
# Where the Frontend layer reaches the Backend layer. Both apps live in one
# uvicorn process, but the hop between them is real HTTP so the REST/SSE
# contract is genuinely exercised (System Design Section 6.2).
AXIS_SERVER__BACKEND_BASE_URL=http://127.0.0.1:8000/api/v1
AXIS_SERVER__SESSION_TOKEN_TTL_SECONDS=14400

# ---------------------------------------------------------------------------
# Storage / logging
# ---------------------------------------------------------------------------
AXIS_STORAGE__DB_PATH=var/axis.sqlite
AXIS_LOG_LEVEL=INFO
