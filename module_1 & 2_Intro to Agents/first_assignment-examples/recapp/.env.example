# Copy this file to .env.local and fill in your own values. .env.local is
# gitignored, so a real key never gets committed. Restart npm run dev after
# you change it.

# Required. Your Anthropic API key, or the token your LLM proxy expects.
ANTHROPIC_API_KEY=

# Optional. The endpoint to call, without /v1/messages on the end.
# Leave it blank to call https://api.anthropic.com directly. Set it to your
# LLM proxy to send the transcript there instead.
ANTHROPIC_BASE_URL=

# Optional. The model name your endpoint knows.
# Leave it blank to use claude-sonnet-5. A proxy MAY set its own names.
# A trailing bracket suffix comes off, so your-model-name[1m] is sent as
# your-model-name.
ANTHROPIC_DEFAULT_SONNET_MODEL=
